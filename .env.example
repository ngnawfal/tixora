# ============================================================
# TIXORA — Konfigurasi Lingkungan (Template)
# Salin file ini menjadi .env dan sesuaikan nilai di bawah ini.
# JANGAN PERNAH commit file .env ke repository publik.
# ============================================================

APP_NAME="TIXORA"
APP_ENV=local
# Opsional: set URL tetap untuk mencegah Host Header Injection di production
# Contoh: https://tixora.nawf.dev/
APP_URL=
# Ganti dengan string acak minimal 32 karakter (untuk HMAC e-ticket & keamanan internal)
APP_KEY=ganti-dengan-kunci-rahasia-acak-minimal-32-karakter

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_tixora
DB_USER=root
DB_PASS=

# Payment Gateway (Bayar.GG)
# Wajib rotasi API Key & Webhook Secret jika sebelumnya sempat hardcoded
BAYARGG_API_KEY=
BAYARGG_WEBHOOK_SECRET=
# Set true di production; set false hanya jika SSL CA lokal XAMPP bermasalah
BAYARGG_VERIFY_SSL=true
